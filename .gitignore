.env
.env.*
.env/
.venv/
venv/
.vscode/
.idea/

# OS junk
.DS_Store
Thumbs.db

# Tests
check_env.py
.pytest_cache/

# Python bytecode / packaging
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/

# Logs
*.log

# Node (frontend tooling, if ever added)
node_modules/

# Database & session data
# All local SQLite databases are legacy/scratch now that the app and the
# training pipeline both read/write Neon Postgres (see api/db.py and
# scripts/migrate_to_neon.py / scripts/migrate_training_to_neon.py).
data/*.db
data/*.db.bak.*
data/chat_sessions.json

# Runtime & user data (should not be tracked)
data/user_memory.json

# Per-session chat/memory data now lives in MongoDB (api/session_store.py,
# api/memory_store.py) - these directories are dead, but keep them ignored
# in case anything ever writes a stray local file again.
data/chat_sessions/
data/user_memory/

# Read-through PDF cache (rag/mongo_pdf_store.py) - GridFS is the source of
# truth, this is regenerated on demand.
data/pdf_cache/

# Generated/derived data (regenerate via scripts/import_and_train.py)
data/cleaned/

# Chroma/vector DB (large, generated, machine-specific)
data/contest_chroma/

# ML model artifacts (regenerate via models/train.py)
models/*.pkl
models/*.joblib

# Runtime-generated PDFs served to users (not source content)
frontend/generated/

# Downloaded embedding model weights (see rag/embeddings.py) - large binary
# files, re-downloadable via scripts/warm_embedding_cache.py
data/embedding_cache/